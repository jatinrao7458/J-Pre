# ── J-pre Environment Variables ──
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Core
GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb://localhost:27017/jpre

# Twitter/X OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# GitHub Backup (PAT with 'repo' scope)
GITHUB_TOKEN=
GITHUB_BACKUP_REPO=your_username/jpre-backups

# YouTube Data API v3
YOUTUBE_API_KEY=

# Google OAuth (Calendar API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LeetCode
LEETCODE_USERNAME=your_leetcode_username

# Server
PORT=3000
